{
  "info": {
    "_postman_id": "trekgear-audit-trail-collection",
    "name": "TrekGear Hub - Member 5 Audit Trail",
    "description": "Postman collection covering Mandatory and Additional test cases for Member 5: Audit Trail Implementation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Mandatory Test 1 - Add a tent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tent_name\": \"Mountain Explorer\",\n  \"size\": \"4-person\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/tents",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["tents"]
        },
        "description": "Expected: Status 201 Created. Tent inserted. One ADD audit record created."
      }
    },
    {
      "name": "Mandatory Test 2 - Update tent 1",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tent_name\": \"Mountain Explorer Pro\",\n  \"size\": \"6-person\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/tents/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["tents", "1"]
        },
        "description": "Expected: Status 200 OK. Tent updated. One UPDATE audit record created."
      }
    },
    {
      "name": "Mandatory Test 3 - Check audit trail",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/audit",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["audit"]
        },
        "description": "Expected: Status 200 OK. Exactly 2 records. UPDATE first, ADD second."
      }
    },
    {
      "name": "Additional Test 4 - Invalid Add (Validation failure)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tent_name\": \"\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/tents",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["tents"]
        },
        "description": "Expected: Status 400 Bad Request. No audit entry created."
      }
    },
    {
      "name": "Additional Test 5 - Update nonexistent tent",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tent_name\": \"Ghost Tent\",\n  \"size\": \"2-person\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/tents/99999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["tents", "99999"]
        },
        "description": "Expected: Status 404 Not Found. No audit entry created."
      }
    },
    {
      "name": "Additional Test 6 - Delete nonexistent tent",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/tents/99999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["tents", "99999"]
        },
        "description": "Expected: Status 404 Not Found. No audit entry created."
      }
    },
    {
      "name": "Additional Test 7 - Delete existing tent 1",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/tents/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["tents", "1"]
        },
        "description": "Expected: Status 200 OK. Tent deleted. One DELETE audit record created."
      }
    },
    {
      "name": "Get all tents",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/tents",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["tents"]
        },
        "description": "Fetch all tents from catalog."
      }
    }
  ]
}
