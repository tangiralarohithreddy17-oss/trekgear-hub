        {
          "name": "8. GET /audit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Audit response is an array of max 10 records\", function () {",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.length).to.be.at.most(10);",
                  "});",
                  "",
                  "if (jsonData.length > 1) {",
                  "    pm.test(\"Audit records ordered newest first (descending audit_id)\", function () {",
                  "        for (var i = 0; i < jsonData.length - 1; i++) {",
                  "            pm.expect(jsonData[i].audit_id).to.be.above(jsonData[i+1].audit_id);",
                  "        }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit",
              "host": ["{{baseUrl}}"],
              "path": ["audit"]
            },
            "description": "Endpoint: GET /audit\n\nImplementation Status: IMPLEMENTED & WORKING.\n\nDescription: Retrieves the 10 most recent audit records sorted newest first (`ORDER BY audit_id DESC LIMIT 10`). Returns fields: `audit_id`, `action`, `id`, `time`."
          },
          "response": []
        },
