              "raw": "{{baseUrl}}/tents",
              "host": ["{{baseUrl}}"],
              "path": ["tents"]
            },
            "description": "Endpoint: POST /tents\n\nImplementation Status: IMPLEMENTED & WORKING.\n\nDescription: Adds a new tent to the inventory. Automatically writes an 'ADD' record to the audit table within an atomic SQLite transaction."
          },
          "response": []
        },
