          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tents/{{tent_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["tents", "{{tent_id}}"]
            },
            "description": "Endpoint: DELETE /tents/:id\n\nImplementation Status: IMPLEMENTED & WORKING.\n\nDescription: Deletes a tent by ID. Automatically writes a 'DELETE' record to the audit table within an atomic SQLite transaction."
          },
          "response": []
        },
