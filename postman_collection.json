  "item": [
    {
      "name": "1. Core API Endpoints (Part 1)",
      "description": "The 10 core API requests specified for TrekGear Hub testing.",
      "item": [
        {
          "name": "1. GET /trekkers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code check - Unimplemented route returns 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error message confirms endpoint not found\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"Endpoint not found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trekkers",
              "host": ["{{baseUrl}}"],
              "path": ["trekkers"]
            },
            "description": "Endpoint: GET /trekkers\n\nImplementation Status: NOT YET IMPLEMENTED.\n\nDescription: Intended for fetching registered trekkers. Route is currently unmounted in `src/app.js`, returning HTTP 404 with `{\"error\": \"Endpoint not found\"}`."
          },
          "response": []
        },
        {
          "name": "2. GET /tents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of tents\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tents",
              "host": ["{{baseUrl}}"],
              "path": ["tents"]
            },
            "description": "Endpoint: GET /tents\n\nImplementation Status: IMPLEMENTED & WORKING.\n\nDescription: Retrieves all tents from the catalog, ordered by tent_id ascending."
          },
          "response": []
        },
        {
          "name": "3. GET /tents/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 404 Not Found\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Response contains tent object with valid properties\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property(\"tent_id\");",
                  "        pm.expect(jsonData).to.have.property(\"tent_name\");",
                  "        pm.expect(jsonData).to.have.property(\"size\");",
                  "        pm.expect(jsonData).to.have.property(\"status\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tents/{{tent_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["tents", "{{tent_id}}"]
            },
            "description": "Endpoint: GET /tents/:id\n\nImplementation Status: IMPLEMENTED & WORKING.\n\nDescription: Fetches single tent details by ID. Returns 200 if found, 404 if nonexistent."
          },
          "response": []
        },
        {
          "name": "4. POST /tents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Created tent has valid properties\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"tent_id\");",
                  "    pm.expect(jsonData.tent_name).to.eql(\"Mountain Explorer\");",
                  "    pm.expect(jsonData.size).to.eql(\"4-person\");",
                  "});",
                  "",
                  "if (jsonData.tent_id) {",
                  "    pm.collectionVariables.set(\"tent_id\", jsonData.tent_id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tent_name\": \"Mountain Explorer\",\n  \"size\": \"4-person\",\n  \"status\": \"available\"\n}"
