    {
      "name": "3. Audit Trail Sequence (Part 3)",
      "description": "Exact required sequence: Test 1 (POST 201) -> Test 2 (PUT 200) -> Test 3 (GET /audit: 2 records, UPDATE first, ADD second), followed by DELETE audit verification.",
      "item": [
        {
          "name": "Test 1: POST /tents (Audit sequence creation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expected Status: 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Tent successfully created with ID\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"tent_id\");",
                  "    pm.expect(jsonData.tent_name).to.eql(\"Mountain Explorer\");",
                  "    pm.expect(jsonData.size).to.eql(\"4-person\");",
                  "});",
                  "",
                  "if (jsonData.tent_id) {",
                  "    pm.collectionVariables.set(\"audit_tent_id\", jsonData.tent_id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tent_name\": \"Mountain Explorer\",\n  \"size\": \"4-person\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tents",
              "host": ["{{baseUrl}}"],
              "path": ["tents"]
            },
            "description": "Test 1 in sequence: POST /tents. Expected Status: 201. Automatically logs 'ADD' audit entry."
          },
          "response": []
        },
        {
          "name": "Test 2: PUT /tents/1 (Audit sequence update)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expected Status: 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Tent updated to new name and size\", function () {",
                  "    pm.expect(jsonData.tent_name).to.eql(\"Mountain Explorer Pro\");",
                  "    pm.expect(jsonData.size).to.eql(\"6-person\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tent_name\": \"Mountain Explorer Pro\",\n  \"size\": \"6-person\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tents/{{audit_tent_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["tents", "{{audit_tent_id}}"]
            },
            "description": "Test 2 in sequence: PUT /tents/{{audit_tent_id}}. Expected Status: 200. Automatically logs 'UPDATE' audit entry."
          },
          "response": []
        },
        {
          "name": "Test 3: GET /audit (Verify 2 records: UPDATE first, ADD second)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expected Status: 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "var targetId = parseInt(pm.collectionVariables.get(\"audit_tent_id\"), 10);",
                  "",
